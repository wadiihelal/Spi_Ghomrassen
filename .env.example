# Serveur de test (Lot 1 bis) : copier en « .env » a la racine du depot sur le serveur, jamais
# versionne. Docker Compose le lit automatiquement. Voir docs/SERVEUR-DE-TEST.md.
#
# Mot de passe PostgreSQL, partage entre les conteneurs postgres et backend. Vide = « spi »
# (le defaut du poste de developpement) ; sur un serveur, en tirer un :
#   openssl rand -base64 24
# Il n'est lu qu'a la CREATION du volume : le fixer avant le premier « up ».
DB_PASSWORD=
# Port public de la demonstration. Vide = 80. A fixer (ex. 8088) si le serveur sert deja un site
# sur le port 80 ; l'adresse devient alors http://<IP>:8088/
DEMO_HTTP_PORT=

# Adresse EXACTE par laquelle on ouvre l'application, port compris — par exemple
# http://102.204.206.105:8088 (sans barre oblique finale). Le navigateur envoie un en-tete Origin
# sur toute ECRITURE, meme en meme origine : si cette valeur ne correspond pas, les listes
# s'affichent mais toute creation echoue avec « Acces refuse » (403 Invalid CORS request).
# Plusieurs adresses se separent par une virgule.
APP_CORS_ALLOWED_ORIGINS=
