# PrimeNG 17 declare @angular/common ^17 || ^18 en peer dependency ; le projet est sur
# Angular 19, qui fonctionne en pratique. Sans cette ligne, `npm ci` refuse l'installation
# sur toute machine neuve (CI GitHub, poste vierge, frontend-maven-plugin). Passer a
# PrimeNG 19 est un chantier a part : nouveau systeme de themes, components.css a reprendre.
legacy-peer-deps=true
